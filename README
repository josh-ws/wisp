A toy lisp for learning purposes.

  > (+ 1 2 3)
  6

  > (equal? 'foo 'foo)
  #t
  > (equal? '(1 2) '(1 2))
  #t

  > (cons 1 (cons 2 '()))
  (1 2)
  > (car '(a b c))
  a
  > (cdr '(a b c))
  (b c)
  > (null? '())
  #t

  > (define double (lambda (x) (+ x x)))
  > (double 21)
  42

  > (define length (lambda (xs) (if (null? xs) 0 (+ 1 (length (cdr xs))))))
  > (length '(a b c d))
  4

  > (define sum (lambda (xs) (if (null? xs) 0 (+ (car xs) (sum (cdr xs))))))
  > (sum '(10 20 30))
  60

  > (define map
      (lambda (f xs)
        (if (null? xs) '()
            (cons (f (car xs)) (map f (cdr xs))))))
  > (map (lambda (n) (+ n 1)) '(1 2 3))
  (2 3 4)

  > (define adder (lambda (n) (lambda (x) (+ x n))))
  > (define add10 (adder 10))
  > (add10 5)
  15

  > (define filter
      (lambda (p xs)
        (if (null? xs) '()
            (if (p (car xs))
                (cons (car xs) (filter p (cdr xs)))
                (filter p (cdr xs))))))
  > (define keep (lambda (v) (lambda (x) (equal? x v))))
  > (filter (keep 'yes) '(yes no yes yes no))
  (yes yes yes)